# Copy to .env.local for dev, or set in the Vercel dashboard.
# Vite only exposes variables prefixed with VITE_, and they are baked into the
# bundle at build time — they are PUBLIC. Never put secrets here.

# Leave blank to run the site purely on its built-in content (no backend).
VITE_API_URL=http://127.0.0.1:8000
