*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments — never commit these, they are hundreds of MB and
# platform-specific. `pip install -r requirements.txt` rebuilds them.
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------ Django
# Local database. Production uses Postgres via DATABASE_URL.
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Uploaded files: gallery photos, portraits, brochures and — importantly —
# students' birth certificates and transfer certificates. These must never
# reach GitHub.
media/

# Generated by `collectstatic` at build time.
staticfiles/
static_root/

# Secrets
.env
.env.*
!.env.example

