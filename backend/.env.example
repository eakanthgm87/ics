# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://*.onrender.com

# ------------------------------------------------------------ database
# Leave blank locally to use SQLite. On Render, paste the Internal
# Database URL from your Postgres instance.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSL_REQUIRE=False

# ---------------------------------------------------------------- CORS
# The frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Public URL of THIS backend — used to build absolute media URLs.
# e.g. https://ics-backend.onrender.com
PUBLIC_BASE_URL=

# --------------------------------------------------------------- email
# Gmail needs an App Password, not your login password:
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords  -> create one
#   3. Paste the 16-character password below
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=youraddress@gmail.com

# Who gets notified when a form is submitted (comma-separated)
NOTIFY_EMAILS=indiranagarcambridgeschool@gmail.com

# ------------------------------------------------------------ WhatsApp
# CallMeBot is free. To get a key:
#   1. Save +34 621 331 709 as a contact
#   2. WhatsApp it: "I allow callmebot to send me messages"
#   3. It replies with your apikey
WHATSAPP_ENABLED=False
WHATSAPP_PHONE=+919902076777
WHATSAPP_APIKEY=

# ------------------------------------------------------------ throttle
THROTTLE_ANON=60/hour
THROTTLE_FORMS=10/hour
